##############################################################
# CQMP — Environment Configuration Template
# Copy to .env and fill in your production values
# NEVER commit the real .env to version control
##############################################################

# ── Application ──────────────────────────────────────────
APP_NAME="Clinic Queue Management Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.ferozamedicinecorner.com
FRONTEND_URL=https://serial.ferozamedicinecorner.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ── Security ──────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────
# Production: use 'daily' to rotate logs, level 'warning' minimum
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ── Database (MySQL for production) ───────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# ── Session ───────────────────────────────────────────────
# cross-subdomain: SameSite=None requires Secure=true (HTTPS)
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ferozamedicinecorner.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# ── Cache ─────────────────────────────────────────────────
# file cache is fastest on shared cPanel (no Redis required)
CACHE_STORE=file

# ── Queue ─────────────────────────────────────────────────
# database driver requires the jobs table (already migrated)
QUEUE_CONNECTION=database

# ── Filesystem ────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Broadcasting ──────────────────────────────────────────
BROADCAST_CONNECTION=reverb

# ── Laravel Reverb WebSocket ──────────────────────────────
REVERB_APP_ID=cqmp-prod-app-id
REVERB_APP_KEY=your-reverb-app-key-here
REVERB_APP_SECRET=your-reverb-app-secret-here
REVERB_HOST=api.ferozamedicinecorner.com
REVERB_PORT=443
REVERB_SCHEME=https

# Reverb server listen address (0.0.0.0 to accept all connections on the server)
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# ── Sanctum ───────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=serial.ferozamedicinecorner.com
SANCTUM_TOKEN_EXPIRATION=1440

# ── CORS / Allowed Origins ────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://serial.ferozamedicinecorner.com

# ── Vite / Frontend Build ─────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="https://api.ferozamedicinecorner.com/api/v1"
VITE_BASE_URL="https://serial.ferozamedicinecorner.com"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Mail ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.ferozamedicinecorner.com
MAIL_PORT=587
MAIL_USERNAME=noreply@ferozamedicinecorner.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS="noreply@ferozamedicinecorner.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (only if using S3 storage — leave blank otherwise) ─
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Redis (optional — only if host provides Redis) ─────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379


# ──────────────────────────────────────────────────────────────
# CQMP Frontend — Development Environment Template
# Copy to .env.local and adjust for your dev setup
# ──────────────────────────────────────────────────────────────

# Local Laravel API
VITE_API_URL=http://localhost:8000/api/v1

# Local frontend base URL
VITE_BASE_URL=http://localhost:5173

# Local Reverb WebSocket server
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Must match REVERB_APP_KEY in backend/.env
VITE_REVERB_APP_KEY=cqmp-reverb-key
